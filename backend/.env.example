# Copy to backend/.env; python-dotenv loads it without overriding exported variables.
# Generate a local key using the command in README.md before running Django.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Asia/Tehran

# Local development uses SQLite by default.
DB_ENGINE=sqlite

# Future PostgreSQL configuration (also install psycopg[binary]).
# DB_ENGINE=postgresql
# DB_NAME=parsian_company
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=require
